{%- comment -%}
  Modulshop line icons. Usage: {% render 'ms-icon', name: 'truck', size: 22 %}
{%- endcomment -%}
{%- liquid
  assign s = size | default: 22
-%}
<svg class="ms-icon ms-icon--{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'truck' -%}
      <path d="M3 6.5h11v9H3zM14 9.5h3.6l3.4 3.4v2.6h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
    {%- when 'bolt' -%}
      <path d="M13 2.5 4.5 13.5H12l-1 8 8.5-11H12z"/>
    {%- when 'box' -%}
      <path d="m12 2.8 8.5 4.4v9.6L12 21.2l-8.5-4.4V7.2z"/><path d="m3.6 7.3 8.4 4.4 8.4-4.4M12 11.7v9.4"/>
    {%- when 'return' -%}
      <path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
    {%- when 'pin' -%}
      <path d="M12 21s-7-6.2-7-11.5a7 7 0 1 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'shield' -%}
      <path d="M12 2.8 4.5 5.6v6c0 4.6 3.2 8.3 7.5 9.6 4.3-1.3 7.5-5 7.5-9.6v-6z"/><path d="m8.8 12 2.2 2.2 4.4-4.4"/>
    {%- when 'chip' -%}
      <rect x="6.5" y="6.5" width="11" height="11" rx="1.5"/><rect x="9.5" y="9.5" width="5" height="5" rx=".5"/><path d="M9.5 3v3.5M14.5 3v3.5M9.5 17.5V21M14.5 17.5V21M3 9.5h3.5M3 14.5h3.5M17.5 9.5H21M17.5 14.5H21"/>
    {%- when 'school' -%}
      <path d="m2.5 9 9.5-5 9.5 5-9.5 5z"/><path d="M6.5 11.2v4.6c1.5 1.5 3.4 2.2 5.5 2.2s4-.7 5.5-2.2v-4.6M21.5 9v5.5"/>
    {%- when 'wrench' -%}
      <path d="M14.7 6.3a4 4 0 0 0 5 5L21 12.6l-.1.1a6 6 0 0 1-7.4.9L6.6 20.5a2.1 2.1 0 0 1-3-3l6.9-6.9a6 6 0 0 1 .9-7.4l.1-.1 1.3 1.3z"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>
    {%- when 'phone' -%}
      <path d="M5 3.5h3.2l1.6 4.2-2.1 1.3a11 11 0 0 0 5.3 5.3l1.3-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5C9.4 19 5 14.6 4.5 6.2A2.5 2.5 0 0 1 5 3.5z"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.3-4.3"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'check' -%}
      <path d="m4.5 12.5 4.5 4.5 10.5-10.5"/>
    {%- when 'star' -%}
      <path fill="currentColor" stroke="none" d="m12 2.8 2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3-4.6-4.4 6.3-.9z"/>
    {%- when 'quote' -%}
      <path fill="currentColor" stroke="none" d="M9.6 6C6.4 7.3 4.5 9.9 4.5 13.4V18h6v-6H7.4c.2-1.9 1.4-3.3 3.3-4.1zm9 0c-3.2 1.3-5.1 3.9-5.1 7.4V18h6v-6h-3.1c.2-1.9 1.4-3.3 3.3-4.1z"/>
    {%- when 'gift' -%}
      <rect x="3.5" y="8" width="17" height="4" rx="1"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8S10.8 3.5 8.2 3.5a2.2 2.2 0 0 0 0 4.5zm0 0s1.2-4.5 3.8-4.5a2.2 2.2 0 0 1 0 4.5z"/>
    {%- when 'sparkle' -%}
      <path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/>
    {%- else -%}
      <circle cx="12" cy="12" r="8"/>
  {%- endcase -%}
</svg>
