{%- comment -%}
  Modulshop – free shipping progress (threshold from theme setting "ms_free_shipping_threshold", HUF).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.ms_free_shipping_threshold | default: 0 | times: 100
  if threshold > 0 and cart.item_count > 0
    assign total = cart.total_price
    assign remaining = threshold | minus: total
    assign pct = total | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}
{%- if threshold > 0 and cart.item_count > 0 -%}
  <div class="ms-ship{% if remaining <= 0 %} is-done{% endif %}" role="status">
    <p class="ms-ship__text">
      {%- if remaining > 0 -%}
        Még <strong>{{ remaining | money_without_trailing_zeros }}</strong> és <strong>ingyenes a szállítás</strong>!
      {%- else -%}
        {% render 'ms-icon', name: 'check', size: 16 %} <strong>Ingyenes szállítást kapsz</strong> erre a rendelésre.
      {%- endif -%}
    </p>
    <span class="ms-ship__bar" aria-hidden="true"><span style="width: {{ pct }}%"></span></span>
  </div>
{%- endif -%}
