      "blocks": {
        "f1": {
          "type": "faq",
          "settings": {
            "question": "Mennyi idő alatt érkezik meg a rendelésem?",
            "answer": "<p>Raktáron lévő terméknél a kiszállítás 1–4 munkanap. A délelőtt 10 óráig leadott rendeléseket még aznap átadjuk a futárcégeknek.</p>"
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "question": "Át tudom venni személyesen?",
            "answer": "<p>Igen, az online leadott rendelés a budapesti átvételi ponton azonnal átvehető, nyitvatartási időben. Helyben vásárlásra nincs lehetőség, csak webáruházként működünk.</p>"
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "question": "Milyen szállítási módok közül választhatok?",
            "answer": "<p>Csomagautomata (Foxpost, MPL, GLS), házhozszállítás (MPL, GLS), csomagpont és posta, valamint személyes átvétel Budapesten.</p>"
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "question": "Mi van, ha nem vagyok elégedett?",
            "answer": "<p>A vásárlástól számított 30 napon belül kérdés nélkül visszaküldheted vagy cserélheted a terméket, ingyenes GLS-automatás visszaküldéssel. Minden termékre 1 év garanciát vállalunk.</p>"
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "question": "Az árak tartalmazzák az ÁFA-t?",
            "answer": "<p>Igen, minden feltüntetett ár bruttó ár.</p>"
          }
        }
      },
