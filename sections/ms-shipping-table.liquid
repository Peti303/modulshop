{%- comment -%}
  Modulshop – shipping methods and prices
  Blocks: "Szállítási mód" (group heading + icon) followed by its "Díj" rows (carrier, price, note).
{%- endcomment -%}
{%- liquid
  assign threshold = settings.ms_free_shipping_threshold | default: 0 | times: 100
  assign open = false
-%}
<section class="ms-section ms-ship-table{% if section.settings.surface %} ms-section--surface{% endif %}" aria-labelledby="ms-shipt-{{ section.id }}">
  <div class="ms-container">
    <div class="ms-section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="ms-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="ms-shipt-{{ section.id }}" class="ms-heading">{{ section.settings.title | default: 'Szállítási díjak' | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="ms-lead">{{ section.settings.text }}</div>{%- endif -%}
      </div>
    </div>

    <div class="ms-ship-table__grid">
      {%- if section.settings.pickup_title != blank -%}
        <div class="ms-ship-table__card ms-ship-table__card--pickup ms-card">
          <div class="ms-ship-table__card-head">
            <span class="ms-icon-badge">{% render 'ms-icon', name: 'pin' %}</span>
            <h3>{{ section.settings.pickup_title | escape }}</h3>
            {%- if section.settings.pickup_price != blank -%}
              <span class="ms-ship-table__badge">{{ section.settings.pickup_price | escape }}</span>
            {%- endif -%}
          </div>
          {%- if section.settings.pickup_text != blank -%}
            <div class="ms-ship-table__pickup-text">{{ section.settings.pickup_text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- if open -%}</tbody></table></div>{%- endif -%}
          {%- assign open = true -%}
          <div class="ms-ship-table__card ms-card" {{ block.shopify_attributes }}>
            <div class="ms-ship-table__card-head">
              <span class="ms-icon-badge">{% render 'ms-icon', name: block.settings.icon %}</span>
              <h3>{{ block.settings.title | escape }}</h3>
            </div>
            {%- if block.settings.text != blank -%}
              <p class="ms-ship-table__group-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            <table class="ms-ship-table__table">
              <caption class="ms-visually-hidden">{{ block.settings.title | escape }} – díjak</caption>
              <thead>
                <tr>
                  <th scope="col">Szolgáltató</th>
                  <th scope="col">Díj</th>
                </tr>
              </thead>
              <tbody>
        {%- elsif block.type == 'rate' -%}
          {%- unless open -%}
            {%- assign open = true -%}
            <div class="ms-ship-table__card ms-card">
              <table class="ms-ship-table__table">
                <thead>
                  <tr>
                    <th scope="col">Szolgáltató</th>
                    <th scope="col">Díj</th>
                  </tr>
                </thead>
                <tbody>
          {%- endunless -%}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">
              {{ block.settings.carrier | escape }}
              {%- if block.settings.note != blank -%}<small>{{ block.settings.note | escape }}</small>{%- endif -%}
            </th>
            <td>{{ block.settings.price | escape }}</td>
          </tr>
        {%- endif -%}
      {%- endfor -%}
      {%- if open -%}</tbody></table></div>{%- endif -%}
    </div>

    {%- if section.settings.show_free_shipping and threshold > 0 -%}
      <p class="ms-ship-table__free">
        {%- render 'ms-icon', name: 'gift', size: 20 -%}
        <span><strong>{{ threshold | money_without_trailing_zeros }}</strong> feletti rendelésnél ingyenes a szállítás.</span>
      </p>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <div class="ms-ship-table__foot">{{ section.settings.footnote }}</div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .ms-ship-table__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
    align-items: start;
  }
  .ms-ship-table__card {
    padding: 22px;
  }
  .ms-ship-table__card--pickup {
    border-color: rgb(var(--ms-accent-rgb) / 0.45);
    background: linear-gradient(160deg, var(--ms-accent-soft), var(--ms-card) 70%);
  }
  .ms-ship-table__card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .ms-ship-table__card-head h3 {
    flex: 1 1 auto;
    margin: 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ms-text);
  }
  .ms-ship-table__badge {
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--ms-success-soft);
    color: var(--ms-success);
    font-size: 14px;
    font-weight: 700;
  }
  .ms-ship-table__pickup-text,
  .ms-ship-table__group-text {
    margin: 0 0 8px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--ms-text-muted);
  }
  .ms-ship-table__pickup-text p {
    margin: 0 0 6px;
  }
  .ms-ship-table__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .ms-ship-table__table thead th {
    padding: 0 0 8px;
    border-bottom: 1px solid var(--ms-border);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    color: var(--ms-text-muted);
  }
  .ms-ship-table__table thead th:last-child,
  .ms-ship-table__table td {
    text-align: right;
  }
  .ms-ship-table__table tbody th,
  .ms-ship-table__table td {
    padding: 12px 0;
    border-bottom: 1px solid var(--ms-border);
    vertical-align: top;
  }
  .ms-ship-table__table tbody tr:last-child th,
  .ms-ship-table__table tbody tr:last-child td {
    border-bottom: 0;
  }
  .ms-ship-table__table tbody th {
    font-weight: 600;
    text-align: left;
    color: var(--ms-text);
  }
  .ms-ship-table__table tbody th small {
    display: block;
    font-size: 13px;
    font-weight: 400;
    color: var(--ms-text-muted);
  }
  .ms-ship-table__table td {
    padding-left: 12px;
    font-weight: 700;
    white-space: nowrap;
    color: var(--ms-primary);
    font-variant-numeric: tabular-nums;
  }
  .ms-ship-table__free {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 20px 0 0;
    padding: 14px 18px;
    border-radius: var(--ms-radius);
    background: var(--ms-success-soft);
    color: var(--ms-text);
  }
  .ms-ship-table__free svg {
    flex: none;
    color: var(--ms-success);
  }
  .ms-ship-table__foot {
    margin-top: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ms-text-muted);
  }
  .ms-ship-table__foot p {
    margin: 0 0 6px;
  }
  .ms-ship-table__foot a {
    color: var(--ms-primary);
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · szállítási díjak",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Felső címke" },
    { "type": "text", "id": "title", "label": "Cím", "default": "Szállítási díjak" },
    { "type": "richtext", "id": "text", "label": "Szöveg" },
    { "type": "checkbox", "id": "surface", "label": "Szürke háttér", "default": false },
    { "type": "header", "content": "Személyes átvétel" },
    { "type": "text", "id": "pickup_title", "label": "Cím", "default": "Személyes átvétel", "info": "Üresen hagyva a kártya nem jelenik meg." },
    { "type": "text", "id": "pickup_price", "label": "Díj", "default": "Ingyenes" },
    {
      "type": "richtext",
      "id": "pickup_text",
      "label": "Szöveg",
      "default": "<p>1078 Budapest, Nefelejcs utca 43. (Bejárat a Marek József utca felől.)</p>"
    },
    { "type": "header", "content": "Egyéb" },
    {
      "type": "checkbox",
      "id": "show_free_shipping",
      "label": "Ingyenes szállítás értékhatárának kiírása",
      "info": "Az értékhatár a Téma beállításai › Modulshop menüpontban adható meg.",
      "default": false
    },
    { "type": "richtext", "id": "footnote", "label": "Lábjegyzet" }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Szállítási mód",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "default": "box",
          "options": [
            { "value": "box", "label": "Doboz" },
            { "value": "truck", "label": "Szállítás" },
            { "value": "pin", "label": "Hely" },
            { "value": "mail", "label": "Levél" },
            { "value": "clock", "label": "Óra" }
          ]
        },
        { "type": "text", "id": "title", "label": "Szállítási mód", "default": "Csomagautomatába" },
        { "type": "text", "id": "text", "label": "Rövid leírás" }
      ]
    },
    {
      "type": "rate",
      "name": "Díj",
      "settings": [
        { "type": "text", "id": "carrier", "label": "Szolgáltató" },
        { "type": "text", "id": "price", "label": "Díj", "info": "Pl. 1250 Ft" },
        { "type": "text", "id": "note", "label": "Megjegyzés" }
      ]
    }
  ],
  "presets": [{ "name": "MS · szállítási díjak" }]
}
{% endschema %}
