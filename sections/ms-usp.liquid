{%- comment -%} Modulshop – tények egy sorban (ikonok nélkül) {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <div class="ms-container">
    <ul class="ms-facts" role="list" style="--ms-facts-n: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="ms-facts__item" {{ block.shopify_attributes }}>
          <strong class="ms-facts__title">{{ block.settings.title | escape }}</strong>
          {%- if block.settings.text != blank -%}
            {%- if block.settings.link != blank -%}
              <a class="ms-facts__text" href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <span class="ms-facts__text">{{ block.settings.text | escape }}</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .ms-facts {
    display: grid;
    grid-template-columns: repeat(var(--ms-facts-n, 5), minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--ms-border);
  }
  .ms-facts__item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 22px 20px 22px 0;
  }
  .ms-facts__item + .ms-facts__item {
    padding-left: 20px;
    border-left: 1px solid var(--ms-border);
  }
  .ms-facts__title {
    font-size: 17px;
    line-height: 1.3;
    color: var(--ms-text);
  }
  .ms-facts__text {
    font-size: 14px;
    color: var(--ms-text-muted);
  }
  a.ms-facts__text {
    color: var(--ms-link);
    text-underline-offset: 3px;
  }
  @media (max-width: 989px) {
    .ms-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ms-facts__item,
    .ms-facts__item + .ms-facts__item {
      padding: 16px 16px 16px 0;
      border-left: 0;
      border-top: 1px solid var(--ms-border);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · tények",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "usp",
      "name": "Tény",
      "settings": [
        { "type": "text", "id": "title", "label": "Cím", "default": "Aznapi feladás" },
        { "type": "text", "id": "text", "label": "Szöveg" },
        { "type": "text", "id": "link", "label": "Link (nem kötelező)", "info": "Pl. a vélemények forrása" }
      ]
    }
  ],
  "presets": [{ "name": "MS · tények" }]
}
{% endschema %}
