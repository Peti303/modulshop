{%- comment -%} Modulshop – morzsamenü termék-, kategória- és tartalomoldalra {%- endcomment -%}
{%- liquid
  assign crumb_collection = collection
  if crumb_collection == blank and product != blank
    assign crumb_collection = product.collections | where: 'handle', product.type | first
    if crumb_collection == blank
      assign crumb_collection = product.collections.first
    endif
  endif
-%}
<nav class="ms-crumbs ms-container" aria-label="Morzsamenü">
  <ol role="list">
    <li><a href="{{ routes.root_url }}">{{ section.settings.home_label | escape }}</a></li>
    {%- if crumb_collection != blank -%}
      <li>
        {%- if product != blank -%}
          <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
        {%- else -%}
          <span aria-current="page">{{ crumb_collection.title | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
    {%- if product != blank -%}
      <li><span aria-current="page">{{ product.title | escape }}</span></li>
    {%- elsif page != blank -%}
      <li><span aria-current="page">{{ page.title | escape }}</span></li>
    {%- endif -%}
  </ol>
</nav>

{% stylesheet %}
  .ms-crumbs {
    padding-block: 16px 4px;
  }
  .ms-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    color: var(--ms-text-muted);
  }
  .ms-crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }
  .ms-crumbs li + li::before {
    content: '/';
    color: var(--ms-border-strong);
  }
  .ms-crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--ms-text-muted);
    text-decoration: none;
  }
  .ms-crumbs a:hover {
    color: var(--ms-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ms-crumbs [aria-current] {
    color: var(--ms-text);
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · morzsamenü",
  "settings": [{ "type": "text", "id": "home_label", "label": "A kezdőlap felirata", "default": "Főoldal" }],
  "presets": [{ "name": "MS · morzsamenü" }]
}
{% endschema %}
