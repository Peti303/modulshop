{%- comment -%} Modulshop – benefit cards grid (icon, title, text, optional link) {%- endcomment -%}
<section class="ms-section ms-features{% if section.settings.surface %} ms-section--surface{% endif %}"{% if section.settings.title != blank %} aria-labelledby="ms-feat-{{ section.id }}"{% endif %}>
  <div class="ms-container">
    {%- if section.settings.title != blank or section.settings.text != blank -%}
      <div class="ms-section-head{% if section.settings.center %} ms-section-head--center{% endif %}">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="ms-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if section.settings.title != blank -%}<h2 id="ms-feat-{{ section.id }}" class="ms-heading">{{ section.settings.title | escape }}</h2>{%- endif -%}
          {%- if section.settings.text != blank -%}<div class="ms-lead">{{ section.settings.text }}</div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <ul class="ms-features__grid ms-features__grid--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li class="ms-features__item ms-card ms-reveal" style="transition-delay: {{ forloop.index0 | times: 60 }}ms" {{ block.shopify_attributes }}>
          <span class="ms-icon-badge">{% render 'ms-icon', name: block.settings.icon %}</span>
          <h3 class="ms-features__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.text != blank -%}<div class="ms-features__text">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank -%}
            <a class="ms-link ms-features__link" href="{{ block.settings.link | default: '#' }}">
              {{- block.settings.link_label | escape -}}
              {%- render 'ms-icon', name: 'arrow-right', size: 18 -%}
            </a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ms-features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ms-features__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ms-features__grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .ms-features__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 24px;
    transition: transform 0.25s var(--ms-ease), box-shadow 0.25s, border-color 0.25s;
  }
  .ms-features__item:hover {
    border-color: rgb(var(--ms-accent-rgb) / 0.4);
    box-shadow: var(--ms-shadow);
  }
  .ms-features__title {
    margin: 6px 0 0;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ms-text);
  }
  .ms-features__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ms-text-muted);
  }
  .ms-features__text p {
    margin: 0;
  }
  .ms-features__text a {
    color: var(--ms-primary);
    font-weight: 600;
  }
  .ms-features__link {
    margin-top: auto;
    padding-top: 4px;
  }
  @media (max-width: 989px) {
    .ms-features__grid,
    .ms-features__grid--4 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .ms-features__grid,
    .ms-features__grid--2,
    .ms-features__grid--4 {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · előnykártyák",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Felső címke" },
    { "type": "text", "id": "title", "label": "Cím" },
    { "type": "richtext", "id": "text", "label": "Szöveg" },
    { "type": "checkbox", "id": "center", "label": "Középre igazított cím", "default": false },
    {
      "type": "select",
      "id": "columns",
      "label": "Oszlopok",
      "default": "3",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "checkbox", "id": "surface", "label": "Szürke háttér", "default": false }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Kártya",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ikon",
          "default": "bolt",
          "options": [
            { "value": "truck", "label": "Szállítás" },
            { "value": "bolt", "label": "Villám" },
            { "value": "box", "label": "Doboz" },
            { "value": "return", "label": "Visszaküldés" },
            { "value": "pin", "label": "Hely" },
            { "value": "shield", "label": "Garancia" },
            { "value": "chip", "label": "Chip" },
            { "value": "school", "label": "Iskola" },
            { "value": "wrench", "label": "Csavarkulcs" },
            { "value": "gift", "label": "Ajándék" },
            { "value": "clock", "label": "Óra" },
            { "value": "mail", "label": "Levél" },
            { "value": "phone", "label": "Telefon" },
            { "value": "star", "label": "Csillag" },
            { "value": "sparkle", "label": "Csillogás" },
            { "value": "check", "label": "Pipa" }
          ]
        },
        { "type": "text", "id": "title", "label": "Cím", "default": "Előny" },
        { "type": "richtext", "id": "text", "label": "Szöveg" },
        { "type": "text", "id": "link_label", "label": "Link felirata" },
        { "type": "text", "id": "link", "label": "Link", "info": "Pl. /collections/diy-keszletek vagy teljes webcím" }
      ]
    }
  ],
  "presets": [{ "name": "MS · előnykártyák" }]
}
{% endschema %}
