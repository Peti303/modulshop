{%- comment -%} Modulshop – „Projektből kosár": összeillő termékek egy kattintással {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign total = 0
  assign all_real = true
  assign count = 0
  for block in section.blocks
    assign count = count | plus: 1
    assign p = block.settings.product
    if p == blank or p.available == false
      assign all_real = false
    else
      assign total = total | plus: p.selected_or_first_available_variant.price
    endif
  endfor
  if count == 0
    assign all_real = false
  endif
-%}
{%- if count > 0 -%}
<section class="ms-section" aria-labelledby="ms-bundle-{{ section.id }}">
  <div class="ms-container">
    <div class="ms-band ms-bundle" data-ms-glow>
      <div class="ms-band__glow" aria-hidden="true"></div>
      <div class="ms-bundle__grid">
        <div class="ms-bundle__copy">
          {%- if s.eyebrow != blank -%}<p class="ms-bundle__eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
          <h2 id="ms-bundle-{{ section.id }}" class="ms-heading">{{ s.title | escape }}</h2>
          {%- if s.text != blank -%}<p class="ms-bundle__text">{{ s.text | escape }}</p>{%- endif -%}
          <div class="ms-bundle__buy">
            {%- if all_real -%}
              <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
                {%- for block in section.blocks -%}
                  <input type="hidden" name="items[{{ forloop.index0 }}][id]" value="{{ block.settings.product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="items[{{ forloop.index0 }}][quantity]" value="1">
                {%- endfor -%}
                <button type="submit" class="ms-btn ms-btn--big">{{ s.button_label | escape }}</button>
              </form>
              <span class="ms-bundle__total"><span>Összesen</span><span class="ms-price">{{ total | money_without_trailing_zeros }}</span></span>
            {%- else -%}
              {%- if s.button_link != blank -%}
                <a class="ms-btn ms-btn--big" href="{{ s.button_link }}">{{ s.fallback_label | escape }}</a>
              {%- endif -%}
              {%- if s.total_text != blank -%}
                <span class="ms-bundle__total"><span>Összesen</span><span class="ms-price">{{ s.total_text | escape }}</span></span>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
        <ul class="ms-bundle__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign p = b.product
              assign title = b.title
              assign price = b.price
              assign stock = b.stock
              assign href = b.link
              assign led = 'ok'
              if p != blank
                assign v = p.selected_or_first_available_variant
                assign title = p.title
                assign href = p.url
                assign price = v.price | money_without_trailing_zeros
                if p.available == false
                  assign led = 'off'
                  assign stock = 'Elfogyott'
                elsif v.inventory_management == 'shopify' and v.inventory_quantity > 0
                  assign stock = v.inventory_quantity | append: ' db raktáron'
                else
                  assign stock = 'Raktáron'
                endif
              endif
            -%}
            <li class="ms-bundle__item" {{ block.shopify_attributes }}>
              <span class="ms-ph ms-bundle__ph">
                {%- if p.featured_image != blank -%}
                  {{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                {%- elsif b.image != blank -%}
                  {{ b.image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                {%- elsif b.asset_image != blank -%}
                  <img src="{{ b.asset_image | asset_url }}" alt="" width="480" height="480" loading="lazy">
                {%- endif -%}
              </span>
              <span class="ms-bundle__meta">
                {%- if href != blank -%}
                  <a class="ms-bundle__name" href="{{ href }}">{{ title | escape }}</a>
                {%- else -%}
                  <span class="ms-bundle__name">{{ title | escape }}</span>
                {%- endif -%}
                {%- if stock != blank -%}
                  <span class="ms-stock ms-stock--{{ led }}"><span class="ms-led ms-led--{{ led }}" aria-hidden="true"></span>{{ stock | escape }}</span>
                {%- endif -%}
              </span>
              {%- if price != blank -%}<span class="ms-price ms-bundle__price">{{ price }}</span>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .ms-bundle__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: center;
    padding: clamp(28px, 5vw, 72px);
  }
  .ms-bundle__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .ms-bundle__eyebrow {
    margin: 0;
    font-weight: 700;
    color: var(--ms-hero-acc);
  }
  .ms-bundle__text {
    margin: 0;
    max-width: 40ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ms-hero-muted);
  }
  .ms-bundle__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    padding-top: 8px;
  }
  .ms-bundle__total {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    color: var(--ms-hero-muted);
  }
  .ms-bundle__total .ms-price {
    font-size: 24px;
    color: var(--ms-hero-ink);
  }
  .ms-bundle__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ms-bundle__item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    padding: 14px 20px 14px 14px;
    border: 1px solid var(--ms-border);
    border-radius: 14px;
    background: var(--ms-card);
    color: var(--ms-text);
    transition: transform 0.3s var(--ms-ease);
  }
  .ms-bundle__item:hover {
    transform: translateX(4px);
  }
  .ms-bundle__ph {
    aspect-ratio: 1 / 1;
    border-radius: 10px;
  }
  .ms-bundle__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .ms-bundle__meta .ms-stock {
    font-size: 13px;
  }
  .ms-bundle__name {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ms-text);
    text-decoration: none;
  }
  .ms-bundle__price {
    font-size: 16px;
  }
  @media (max-width: 989px) {
    .ms-bundle__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "MS · projektből kosár",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Felső felirat", "default": "Projektből kosár" },
    { "type": "text", "id": "title", "label": "Cím", "default": "Wi-Fi-s hőmérő kijelzővel" },
    { "type": "textarea", "id": "text", "label": "Szöveg", "default": "Négy alkatrész, egy kattintás. Minden darab külön is megvehető." },
    { "type": "text", "id": "button_label", "label": "Gomb felirata", "info": "Akkor jelenik meg, ha minden tételnél ki van választva egy raktáron lévő termék.", "default": "Mind a kosárba" },
    { "type": "header", "content": "Amíg nincs minden termék kiválasztva" },
    { "type": "text", "id": "fallback_label", "label": "Gomb felirata", "default": "Megnézem a termékeket" },
    { "type": "text", "id": "button_link", "label": "Gomb linkje", "info": "Pl. /collections/all vagy teljes webcím" },
    { "type": "text", "id": "total_text", "label": "Végösszeg szövege", "info": "Pl. 4 500 Ft" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Tétel",
      "limit": 6,
      "settings": [
        { "type": "product", "id": "product", "label": "Termék", "info": "Ha ki van választva, a név, az ár, a készlet és a kép a termékből jön." },
        { "type": "header", "content": "Kézi adatok (ha nincs termék kiválasztva)" },
        { "type": "text", "id": "title", "label": "Név" },
        { "type": "text", "id": "price", "label": "Ár" },
        { "type": "text", "id": "stock", "label": "Készlet szövege" },
        { "type": "text", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Kép" },
        { "type": "text", "id": "asset_image", "label": "Beépített kép (fájlnév)" }
      ]
    }
  ],
  "presets": [{ "name": "MS · projektből kosár" }]
}
{% endschema %}
